        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدقة 16-bit وغير مضغوط: نسخة رئيسية بلا فقدان لمزيد من التعديل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "16-bit, uncompressed: a lossless master for further editing."
          }
        }
      }
    },
