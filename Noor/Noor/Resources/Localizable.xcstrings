{
  "sourceLanguage": "en",
  "strings": {
    "%@ %lld-bit": {
      "comment": "Format family and bit depth, e.g. “HEIF 10-bit”",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld-bit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld-bit"
          }
        }
      }
    },
    "%@: %@": {
      "comment": "Import failure line: file or preset name, then the reason",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$@: %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@"
          }
        }
      }
    },
    "%@: No presets found.": {
      "comment": "Import failure; %@ is the folder name",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@: لم يُعثر على إعدادات مسبقة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: No presets found."
          }
        }
      }
    },
    "%@: The folder can't be read.": {
      "comment": "Import failure; %@ is the folder name",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@: تعذّرت قراءة المجلد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: The folder can't be read."
          }
        }
      }
    },
    "%lld presets added.": {
      "comment": "Alert message line; %lld is the number of presets added",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تمت إضافة %lld إعدادات مسبقة."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تمت إضافة %lld إعدادًا مسبقًا."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تمت إضافة إعداد مسبق واحد."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تمت إضافة %lld إعداد مسبق."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تمت إضافة إعدادين مسبقين."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لم يُضَف أي إعداد مسبق."
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld presets added."
          }
        }
      }
    },
    "%lld presets imported": {
      "comment": "VoiceOver announcement after a preset import; %lld is the number imported",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تم استيراد %lld إعدادات مسبقة"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تم استيراد %lld إعدادًا مسبقًا"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تم استيراد إعداد مسبق واحد"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تم استيراد %lld إعداد مسبق"
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تم استيراد إعدادين مسبقين"
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لم يُستورد أي إعداد مسبق"
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld presets imported"
          }
        }
      }
    },
    "%lld-bit": {
      "comment": "Bit-depth badge on a library thumbnail, e.g. “16-bit”",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-bit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-bit"
          }
        }
      }
    },
    "10-bit and efficient: the best lossy format.": {
      "comment": "Export format explanation for HEIF 10-bit on iOS 17 (no HDR for edits)",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدقة 10-bit وفعّال: أفضل تنسيق مع فقدان."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "10-bit and efficient: the best lossy format."
          }
        }
      }
    },
    "10-bit and efficient: the best lossy format. Keeps HDR.": {
      "comment": "Export format explanation",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدقة 10-bit وفعّال: أفضل تنسيق مع فقدان. يحافظ على HDR."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "10-bit and efficient: the best lossy format. Keeps HDR."
          }
        }
      }
    },
    "100 is the highest quality. JPEG and HEIF are still lossy formats.": {
      "comment": "Caption under the Quality slider",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القيمة 100 هي أعلى جودة، لكن JPEG وHEIF يبقيان تنسيقين بضغط مع فقدان."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "100 is the highest quality. JPEG and HEIF are still lossy formats."
          }
        }
      }
    },
    "16-bit and lossless. Large files.": {
      "comment": "Export format explanation",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدقة 16-bit وبلا فقدان. ملفات كبيرة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "16-bit and lossless. Large files."
          }
        }
      }
    },
    "16-bit, uncompressed: a lossless master for further editing.": {
      "comment": "Export format explanation",
      "extractionState": "manual",
