// Native macOS target; intentionally independent of iOS SDK settings.
SDKROOT = macosx
LAQTA_LOCAL_DISTRIBUTION = NO
SUPPORTED_PLATFORMS = macosx
SUPPORTS_MACCATALYST = NO
MACOSX_DEPLOYMENT_TARGET = 26.0
PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = Hmdalajmi.Laqta.Mac
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = LaqtaMac/LaqtaMac.entitlements
ENABLE_APP_SANDBOX = YES
ENABLE_HARDENED_RUNTIME = YES
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = LaqtaMac/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Laqta
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.photography
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
MARKETING_VERSION = 1.1
CURRENT_PROJECT_VERSION = 8
SWIFT_VERSION = 6.0
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_EMIT_LOC_STRINGS = NO
STRING_CATALOG_GENERATE_SYMBOLS = NO
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
