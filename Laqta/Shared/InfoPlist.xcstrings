{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقطة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Laqta"
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تضيف لقطة التواريخ التي تجدها في لقطاتك وروابطك إلى تقويمك عند طلبك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Laqta adds dates it finds in your shots and links to your calendar when you ask it to."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم لقطة الكاميرا لمسح المستندات إلى ملفات PDF، ولأخذ لقطة مباشرة إلى أحد مجلداتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Laqta uses the camera to scan documents into PDFs and to take a shot straight into one of your folders."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم لقطة Face ID لفتح مجلداتك الخاصة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Laqta uses Face ID to open your private folders."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض لقطة وقت الوصول إلى الأماكن التي تجدها في لقطاتك وروابطك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Laqta shows the travel time to places found in your shots and links."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تضيف لقطة الصور والفيديو من مكتبتك، وتحذف الأصل — إن فعّلت ذلك — بعد حفظ نسختها الخاصة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Laqta adds photos and videos from your library and, when you turn it on, removes the original after keeping its own copy."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحوّل لقطة كلام الفيديو إلى نص على هذا الجهاز، لتقرأه وتبحث فيه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Laqta transcribes the speech in your videos on this device, so you can read and search it."
          }
        }
      }
    }
  },
  "version": "1.0"
}
